<Project>
  <!-- The commit count only comes from git, so the version is stamped in a
       target rather than during evaluation. GetAssemblyVersion derives
       AssemblyVersion, FileVersion and InformationalVersion from Version, so
       setting Version ahead of it stamps all three. Passing BuildNumber
       explicitly overrides the commit count; a tree without git keeps the
       fallback patch from Directory.Build.props. Packing reads
       PackageVersion, which evaluation already copied from the fallback
       Version, so the target runs ahead of pack's version lookup as well and
       stamps PackageVersion too. -->
  <PropertyGroup>
    <GetPackageVersionDependsOn>$(GetPackageVersionDependsOn);StampVersionFromCommitCount</GetPackageVersionDependsOn>
  </PropertyGroup>

  <Target Name="StampVersionFromCommitCount" BeforeTargets="GetAssemblyVersion;_GetOutputItemsFromPack">
    <Exec Command="git rev-list --count HEAD"
          WorkingDirectory="$(MSBuildThisFileDirectory)"
          Condition="'$(BuildNumber)' == '' And Exists('$(MSBuildThisFileDirectory).git')"
          ConsoleToMSBuild="true"
          StandardOutputImportance="low"
          ContinueOnError="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_CommitCount" />
      <Output TaskParameter="ExitCode" PropertyName="_CommitCountExitCode" />
    </Exec>

    <PropertyGroup Condition="'$(_CommitCountExitCode)' == '0'">
      <BuildNumber>$(_CommitCount.Trim())</BuildNumber>
    </PropertyGroup>

    <PropertyGroup Condition="'$(BuildNumber)' != ''">
      <VersionPatch>$([System.Math]::Max(0, $([MSBuild]::Subtract($(BuildNumber), $(VersionPatchOffset)))))</VersionPatch>
      <Version>$(VersionMajor).$(VersionMinor).$(VersionPatch)</Version>
      <PackageVersion>$(Version)</PackageVersion>
    </PropertyGroup>
  </Target>
</Project>
