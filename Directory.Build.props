<Project>
  <!-- Major and minor are set by hand. The patch counts commits since that
       major.minor was cut, so a given commit stamps the same version wherever
       it is built: CI, a local clone, or an install from a fresh clone.
       VersionPatchOffset is the commit count at the commit that introduced the
       current major.minor, so that commit is patch 0. When changing the major
       or minor, set the offset to the count the bump commit will itself have.
       Counts are inclusive, so that is one more than the commit count reads
       before the bump is committed.
       The patch itself is stamped in Directory.Build.targets, which is where
       the commit count can be read; the 0 here is the fallback for a source
       tree with no git history. -->
  <PropertyGroup>
    <VersionMajor>0</VersionMajor>
    <VersionMinor>3</VersionMinor>
    <VersionPatchOffset>272</VersionPatchOffset>
    <Version>$(VersionMajor).$(VersionMinor).0</Version>
  </PropertyGroup>

  <!-- Every restore records the exact packages it resolved, content hashes
       included, in packages.lock.json. CI restores in locked mode, so a
       package that changed on the feed fails the build instead of shipping. -->
  <PropertyGroup>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
</Project>
